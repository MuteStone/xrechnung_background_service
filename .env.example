# ============================================================
#  XRechnung-Hintergrunddienst — Konfigurationsvorlage
#
#  Kopiere diese Datei zu .env und trage deine Werte ein.
#  Die .env-Datei wird NICHT ins Repository eingecheckt!
#  Gib niemals deine .env weiter oder lade sie hoch.
# ============================================================

# --- Datenbankverbindung ---
# Host der MySQL-Datenbank (i. d. R. localhost oder IP-Adresse des Servers)
DB_HOST=localhost
DB_PORT=3306

# Name der Datenbank (muss mit der Kundenverwaltung übereinstimmen)
DB_NAME=dein_datenbankname

# Datenbankbenutzer — empfohlen: dedizierter Benutzer mit nur SELECT-Rechten
DB_USER=dein_db_benutzer
DB_PASSWORD=dein_db_passwort

# --- Pfade ---
# Watch-Folder = Export-Ordner der Kundenverwaltung (Ablageort der Rechnungs-PDFs)
WATCH_FOLDER=C:\Pfad\zur\Kundenverwaltung\export\pdf

# Zielordner für generierte XRechnung-XML-Dateien
OUTPUT_XML=output/xml

# Zielordner für archivierte PDF-Kopien (optional)
OUTPUT_PDF=output/pdf

# Zielordner für erfolgreich verarbeitete PDFs
PROCESSED_FOLDER=processed

# Zielordner für fehlgeschlagene PDFs
ERROR_FOLDER=error

# --- SMTP (Gmail mit App-Passwort) ---
# Hinweis: Outlook.com unterstützt kein SMTP AUTH — Gmail verwenden.
# App-Passwort erstellen unter: Google-Konto → Sicherheit → App-Passwörter
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-adresse@googlemail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=deine-adresse@googlemail.com
SMTP_FROM_NAME=XRechnung-Dienst

# --- OZG-RE Testportal ---
# Die Empfängeradresse ist kontogebunden und im Portal abrufbar:
# Einstellungen → Postfach → Eingangsadresse
OZG_RE_EMAIL=<uuid>@test-out.ozg.bdr-eservices.de
OZG_RE_SUBJECT=XRechnung Einreichung

# --- KoSIT-Validierung ---
# Prüft die XRechnung vor dem Versand gegen die offiziellen Geschäftsregeln
# (Schematron/KoSIT). Bei Ablehnung wird die Rechnung NICHT versendet, sondern
# nach error/ verschoben. Voraussetzung: der Ordner kosit/ (JRE + Validator +
# Szenario) liegt neben der EXE. true = ein (empfohlen), false = aus.
KOSIT_VALIDATION=true

# --- Logging ---
# Log-Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/xrechnung_dienst.log

# Maximale Dateigröße je Log-Datei in Bytes (Standard: 5 MB)
LOG_MAX_BYTES=5242880

# Anzahl der Sicherungskopien (Log-Rotation)
LOG_BACKUP_COUNT=3
